      },
      {
        "repo": "huggingface/skills",
        "path": "skills/huggingface-local-models/SKILL.md",
        "use": "optional offline model inference"
      },
      {
        "repo": "langchain-ai/langchain-skills",
        "path": "config/skills/langchain-rag/SKILL.md",
        "use": "optional RAG code base"
      }
    ]
  }
}
