# Public TideCloak adapter values. Replace the placeholders after downloading
# the adapter from your own realm; never commit the downloaded adapter.
NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL=http://127.0.0.1:8080/
NEXT_PUBLIC_TIDECLOAK_REALM=your-realm
NEXT_PUBLIC_TIDECLOAK_CLIENT_ID=your-client-id
NEXT_PUBLIC_SECUREDOCS_ORIGIN=http://127.0.0.1:3000
